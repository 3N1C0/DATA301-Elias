# Media. Never commit a recording, especially here: this repo is PUBLIC and
# GitHub caps files at 100MB. Joanna's lecture videos run 120-140MB and live in
# course_materials/, which ignores them too. Videos go to YouTube, linked from
# the website.
*.mp4
*.mov
*.mkv
*.webm
*.avi

# Trained models and large data, same reason. Commit the code that makes them.
*.pt
*.pth
*.h5
*.joblib
*.parquet

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# OS junk
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/

# Scratch/test files - matches this class's own naming convention for
# in-progress copies (see course_materials' day-update skill, step 0)
JUNK*
*Copy1*
Untitled*.ipynb
*-inclasscopy*
